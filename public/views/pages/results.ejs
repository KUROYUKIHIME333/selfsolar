<div class="result-container">
  <h2>☀ Rapport de Dimensionnement Photovoltaïque</h2>
  <a href="/" class="btn-back">← Nouveau calcul</a>

  <div class="card">
    <h3>Bilan Énergétique</h3>
    <div class="grid-3">
      <div>
        <p class="label-sm">Consommation journalière</p>
        <span class="highlight"><%= resultat.energie.journaliere.toFixed(0) %></span>
        <span class="unit"> Wh/j</span>
      </div>
      <div>
        <p class="label-sm">Puissance de crête des charges</p>
        <span class="highlight"><%= resultat.energie.puissanceMax %></span>
        <span class="unit"> W</span>
      </div>
      <div>
        <p class="label-sm">Ensoleillement (HSP)</p>
        <span class="highlight"><%= resultat.geographie.hsp %></span>
        <span class="unit"> kWh/m²/j</span>
        <p style="margin:4px 0 0; font-size:0.8rem; opacity:0.6;">Hémisphère <%= resultat.geographie.hemisphere %> — données NASA POWER</p>
      </div>
    </div>
  </div>

  <div class="card">
    <h3>Champ Photovoltaïque</h3>
    <div class="grid-3">
      <div>
        <p class="label-sm">Puissance crête requise</p>
        <span class="highlight"><%= Math.ceil(resultat.panneaux.puissanceTotale) %></span>
        <span class="unit"> Wc</span>
        <p style="margin:8px 0 0;">Nombre de panneaux : <strong><%= resultat.panneaux.nombre %></strong></p>
      </div>
      <div>
        <p class="label-sm">Tension système</p>
        <span class="badge"><%= resultat.panneaux.tensionSysteme %> V</span>
        <p style="margin:12px 0 0;">
          Montage : <strong><%= resultat.panneaux.serie %></strong> en série<br>
          <strong><%= resultat.panneaux.parallele %></strong> branche(s) en parallèle
        </p>
      </div>
      <div>
        <p class="label-sm">Pose optimisée</p>
        <p style="margin:4px 0;">
          Inclinaison : <strong><%= resultat.panneaux.inclinaison %>°</strong><br>
          Orientation : <strong><%= resultat.panneaux.orientation %></strong>
        </p>
      </div>
    </div>
  </div>

  <% if (resultat.stockage) { %>
  <div class="card">
    <h3>Parc de Batteries</h3>
    <div class="grid-3">
      <div>
        <p class="label-sm">Capacité requise</p>
        <span class="highlight"><%= resultat.stockage.capaciteAh %></span>
        <span class="unit"> Ah</span>
      </div>
      <div>
        <p class="label-sm">Nombre de batteries</p>
        <span class="highlight"><%= resultat.stockage.nbTotal %></span>
        <p style="margin:8px 0 0;">
          Montage : <strong><%= resultat.stockage.montage.serie %></strong> série /
          <strong><%= resultat.stockage.montage.parallele %></strong> parallèle
        </p>
      </div>
    </div>
  </div>
  <% } %>

  <div class="card">
    <h3>Appareillage Électronique</h3>
    <div class="grid-2">
      <div>
        <p class="label-sm">Régulateur de charge</p>
        <span class="badge"><%= resultat.electronique.regulateur.type %></span>
        <p style="margin:10px 0 0;">
          Calibre min : <strong><%= resultat.electronique.regulateur.courantMin.toFixed(1) %> A</strong><br>
          Tension : <strong><%= resultat.electronique.regulateur.tensionFonctionnement %> V</strong>
        </p>
      </div>
      <div>
        <p class="label-sm">Onduleur</p>
        <span class="badge"><%= resultat.electronique.onduleur.type %></span>
        <p style="margin:10px 0 0;">
          Puissance min : <strong><%= Math.ceil(resultat.electronique.onduleur.puissanceMin) %> W</strong><br>
          Tension entrée : <strong><%= resultat.electronique.onduleur.tensionEntree %> V</strong>
        </p>
      </div>
    </div>
  </div>

  <div class="card">
    <h3>Dispositifs de Protection (DC)</h3>

    <div class="protection-item">
      <strong>Protection générale PV → Régulateur</strong><br>
      <%= resultat.protections.generalPV.equipement %>
      <br><small>Calibre : <%= resultat.protections.generalPV.Icc.toFixed(1) %> A &nbsp;|&nbsp; <%= resultat.protections.generalPV.localisation %></small>
    </div>

    <div class="protection-item">
      <strong>Protection individuelle par string</strong><br>
      <%= resultat.protections.individuelString.equipement %>
      <br><small>Calibre : <%= resultat.protections.individuelString.Icc.toFixed(1) %> A &nbsp;|&nbsp; <%= resultat.protections.individuelString.localisation %></small>
    </div>

    <div class="protection-item">
      <strong>Protection Batteries → Onduleur</strong><br>
      <%= resultat.protections.batterieOnduleur.equipement %>
      <br><small>Calibre : <%= resultat.protections.batterieOnduleur.Icc.toFixed(1) %> A &nbsp;|&nbsp; <%= resultat.protections.batterieOnduleur.localisation %></small>
    </div>

    <% if (resultat.stockage) { %>
    <div class="protection-item">
      <strong>Isolation parc batterie</strong><br>
      <%= resultat.protections.sectionneurBatt.equipement %>
      <br><small>Calibre ref. : <%= resultat.protections.sectionneurBatt.Icc %> A &nbsp;|&nbsp; <%= resultat.protections.sectionneurBatt.localisation %></small>
    </div>
    <% } %>
  </div>

  <p style="text-align:center; opacity:0.4; font-size:0.8rem; margin-top:40px;">
    ⚠ Ce rapport est indicatif. Faites valider le dimensionnement par un électricien qualifié avant installation.
  </p>
</div>
