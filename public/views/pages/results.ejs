<div class="result-container">
  <h2>Rapport de Dimensionnement Photovoltaïque</h2>
  <a href="/" class="btn-back">← Nouveau calcul</a>

  <div class="card">
    <h3>Bilan Énergétique</h3>
    <div class="grid-3">
      <div>
        <p>Consommation journalière :<br>
        <span class="highlight"><%= resultat.energie.journaliere.toFixed(2) %></span> <span class="unit">Wh/j</span></p>
      </div>
      <div>
        <p>Puissance de crête des charges :<br>
        <span class="highlight"><%= resultat.energie.puissanceMax %></span> <span class="unit">W</span></p>
      </div>
      <div>
        <p>Ensoleillement (HSP) :<br>
        <span class="highlight"><%= resultat.geographie.hsp %></span> <span class="unit">kWh/m²/j</span></p>
      </div>
    </div>
  </div>

  <div class="card">
    <h3>Champ Photovoltaïque</h3>
    <div class="grid-3">
      <div>
        <p>Puissance totale requise :<br>
        <span class="highlight"><%= Math.ceil(resultat.panneaux.puissanceTotale) %></span> <span class="unit">Wc</span></p>
        <p>Nombre de panneaux : <span class="highlight"><%= resultat.panneaux.nombre %></span></p>
      </div>
      <div>
        <p>Tension du système : <span class="badge"><%= resultat.panneaux.tensionSysteme %> V</span></p>
        <p>Montage : <br>
          <b><%= resultat.panneaux.serie %></b> en série <br>
          <b><%= resultat.panneaux.parallele %></b> branche(s) en parallèle
        </p>
      </div>
      <div>
        <p>Pose optimisée :<br>
        Inclinaison : <b><%= resultat.panneaux.inclinaison %>°</b><br>
        Orientation : <b><%= resultat.panneaux.orientation %></b></p>
      </div>
    </div>
  </div>

  <% if (resultat.stockage) { %>
  <div class="card">
    <h3>Parc de Batteries</h3>
    <div class="grid-3">
      <div>
        <p>Capacité totale utile :<br>
        <span class="highlight"><%= resultat.stockage.capaciteAh %></span> <span class="unit">Ah</span></p>
      </div>
      <div>
        <p>Nombre de batteries : <span class="highlight"><%= resultat.stockage.nbTotal %></span></p>
        <p>Montage : <b><%= resultat.stockage.montage.serie %></b> série / <b><%= resultat.stockage.montage.parallele %></b> parallèle</p>
      </div>
    </div>
  </div>
  <% } %>

  <div class="card">
    <h3>Appareillage Électronique</h3>
    <div class="grid-3">
      <div style="border-right: 1px solid #eee;">
        <p><strong>Régulateur de charge</strong></p>
        <p>Type : <span class="badge"><%= resultat.electronique.regulateur.type %></span></p>
        <p>Calibre min : <b><%= resultat.electronique.regulateur.courantMin.toFixed(2) %> A</b></p>
      </div>
      <div>
        <p><strong>Onduleur</strong></p>
        <p>Type : <span class="badge"><%= resultat.electronique.onduleur.type %></span></p>
        <p>Puissance min : <b><%= Math.ceil(resultat.electronique.onduleur.puissanceMin) %> W</b></p>
      </div>
    </div>
  </div>

  <div class="card">
    <h3>Dispositifs de Protection (DC)</h3>
    
    <div class="protection-item">
      <strong>Protection Générale PV :</strong> <%= resultat.protections.generalPV.equipement %> <br>
      <small>Calibre : <%= resultat.protections.generalPV.Icc.toFixed(2) %> A | <%= resultat.protections.generalPV.localisation %></small>
    </div>

    <div class="protection-item">
      <strong>Protection des Strings :</strong> <%= resultat.protections.individuelString.equipement %> <br>
      <small>Calibre : <%= resultat.protections.individuelString.Icc.toFixed(2) %> A | <%= resultat.protections.individuelString.localisation %></small>
    </div>

    <div class="protection-item">
      <strong>Protection Batterie-Onduleur :</strong> <%= resultat.protections.batterieOnduleur.equipement %> <br>
      <small>Calibre : <%= resultat.protections.batterieOnduleur.Icc.toFixed(2) %> A | <%= resultat.protections.batterieOnduleur.localisation %></small>
    </div>

    <div class="protection-item">
      <strong>Isolation :</strong> <%= resultat.protections.sectionneurBatt.equipement %> <br>
      <small><%= resultat.protections.sectionneurBatt.localisation %></small>
    </div>
  </div>
</div>