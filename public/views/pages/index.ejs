<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<h2 style="text-align: center; color: var(--silver);">☀ Dimensionnement Intelligent</h2>

<form id="datasForm" action="/dimensionner" method="POST">
  
  <fieldset>
    <legend>⚡ Besoins Énergétiques</legend>
    <div id="equipementsContainer"></div>
    <button id="addEquipementButton" type="button" style="margin-top: 15px; background: var(--accent-pink);">
      + Ajouter un appareil
    </button>
    
    <div style="margin-top: 20px;">
      <label class="container">
        <input type="checkbox" name="contientMoteurs"> L'installation contient des moteurs (Frigo, Pompe)
      </label>
    </div>
  </fieldset>

  <fieldset>
    <legend>📍 Localisation</legend>
    <div id="map"></div>
    <div class="grid-2" style="margin-top: 15px;">
      <div>
        <label>Latitude</label>
        <input type="number" id="latInput" name="localisation[lat]" step="any" readonly required style="width: 90%;">
      </div>
      <div>
        <label>Longitude</label>
        <input type="number" id="longInput" name="localisation[long]" step="any" readonly required style="width: 90%;">
      </div>
    </div>
  </fieldset>

  <div class="grid-2">
    <fieldset>
      <legend>🔋 Stockage</legend>
      <select id="selectBatterie" name="caracteristiquesBatterie" style="width: 100%;"></select>
      <div id="infoBatterie" class="details-hint"></div>
      <div style="margin-top:15px">
        <label>Autonomie (jours)</label>
        <input type="number" name="autonomie" value="1" min="1" style="width: 60px;">
      </div>
    </fieldset>

    <fieldset>
      <legend>🛰 Panneaux</legend>
      <select id="selectPanneau" name="caracteristiquesPanneau" style="width: 100%;"></select>
      <div id="infoPanneau" class="details-hint"></div>
    </fieldset>
  </div>

  <button type="submit" style="width:100%; padding: 20px; font-size: 1.2rem; border-radius: 50px; margin-top: 30px;">
    GÉNÉRER LE RAPPORT SOLAIRE
  </button>
</form>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>